# .env.example
# Copy this file to .env and fill in your actual credentials.
# Make sure NOT to commit the .env file to version control.

# --- Database Credentials (PostgreSQL) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=authdb
AUTH_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=authdb;Username=app;Password=app

# --- PgAdmin Credentials ---
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- Auth Service Credentials ---
# The default initial Admin account
ADMIN_USER_EMAIL=admin@admin.com
ADMIN_USER_PASSWORD=Admin123!

# OAuth Google App Client ID
OAUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# --- Email Notifications Configuration (Notifications.Worker) ---
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your.email@gmail.com
EMAIL_PASSWORD=your-16-digit-app-password
EMAIL_FROM_ADDRESS=no-reply@escolhamultipla.pt
